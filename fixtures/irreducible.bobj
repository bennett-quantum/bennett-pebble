bennett-object isa=0.9 object=0.9 launch=0.9 sched=0.9 cert=0.9 coverage=0.9 target=0.9 ptr_width=32

section functions
oracle @irreducible (x:wire[8] in) (t:wire[8]) (f:wire[4]) () ()
regs { n:reg[8], z:reg[8], one:reg[8], bit:reg[8], p:reg[1], done:reg[1] }
^entry():
n = lift.mov x
z = lift.const.i8 0
one = lift.const.i8 1
bit = lift.and n one
p = lift.icmp.eq bit z
qbranch p ^left ^right
^left():
done = lift.icmp.eq n z
qbranch done ^done ^leftmore
^leftmore():
n = lift.lshr n one
qjump ^right
^right():
done = lift.icmp.eq n z
qbranch done ^done ^rightmore
^rightmore():
n = lift.lshr n one
qjump ^left
^done():
lift.retval n
