bennett-object isa=0.9 object=0.9 launch=0.9 sched=0.9 cert=0.9 coverage=0.9 target=0.9 ptr_width=32

section functions
oracle @popcount (x:wire[8] in) (t:wire[8]) (f:wire[4]) () ()
regs { n:reg[8], acc:reg[8], zero:reg[8], one:reg[8], bit:reg[8], done:reg[1] }
^entry():
zero = lift.const.i8 0
one = lift.const.i8 1
n = lift.mov x
acc = lift.const.i8 0
qjump ^test
^test():
done = lift.icmp.eq n zero
qbranch done ^done ^loop
^loop():
bit = lift.and n one
acc = lift.add acc bit
n = lift.lshr n one
qjump ^test
^done():
lift.retval acc
